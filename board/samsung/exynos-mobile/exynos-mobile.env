stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole

blkmapcmd=blkmap create root;
	  blkmap map root 0 ${blkmap_size_r} linear ${blkmap_blk_ifname} ${blkmap_blk_dev} ${blkmap_blk_nr}

pstorecmd=echo "Raw ramoops console header";
	  md.l 46e00000 4;
	  echo "Raw ramoops pmsg header";
	  md.l 46e04000 4;
	  echo "Raw ramoops pmsg payload";
	  md.b 46e0400c 3b8;
	  pstore set 46e00000 8000 0 4000 0 4000 0;
	  pstore display console;
	  pstore display user

breadcrumbcmd=echo "Warm-reset boot breadcrumb";
	md.l 46e07ffc 1

preboot=run breadcrumbcmd; run pstorecmd; run blkmapcmd

bootdelay=0
bootcmd=run fastbootcmd

uefibootcmd=mw.b 46e00000 0 8000;
	mw.l 46e07ffc 4a370001;
	echo "UEFI Boot from nested USERDATA";
	if load blkmap 0:1 ${loadaddr} /EFI/BOOT/BOOTAA64.EFI; then
		mw.l 46e07ffc 4a370002;
		echo "Loaded BOOTAA64.EFI; entering bootefi";
		mw.l 46e07ffc 4a370003;
		bootefi ${loadaddr};
		mw.l 46e07ffc 4a370004;
		echo "bootefi returned";
	else
		echo "Failed to load BOOTAA64.EFI from nested USERDATA";
	fi

directbootcmd=mw.b 46e00000 0 8000;
	mw.l 46e07ffc 4a380001;
	echo "Direct Linux boot from nested USERDATA";
	if load blkmap 0:1 40080000 /vmlinuz; then
		setenv direct_kernel_size ${filesize};
		mw.l 46e07ffc 4a380002;
	else
		echo "Failed to load /vmlinuz from nested USERDATA";
		exit;
	fi;
	if load blkmap 0:1 50000000 /initramfs; then
		setenv direct_initrd_size ${filesize};
	else
		echo "Failed to load /initramfs from nested USERDATA";
		exit;
	fi;
	if load blkmap 0:1 4ff00000 /dtbs/exynos/exynos7870-j7y17lte.dtb; then
		mw.l 46e07ffc 4a380003;
	else
		echo "Failed to load J7 Pro DTB from nested USERDATA";
		exit;
	fi;
	setenv bootargs console=tty0 console=ttySAC2,115200n8 earlycon=exynos4210,0x13820000 ignore_loglevel loglevel=7 initcall_debug printk.time=1 rd.info loop.max_part=7 fbcon=font:TER16x32 root=UUID=f3c5db40-37e6-4aea-a5b8-93224e1b8c69 rootfstype=ext4 rootwait rw pmos_boot_uuid=A2E8-9979 pmos_root_uuid=f3c5db40-37e6-4aea-a5b8-93224e1b8c69 pmos_rootfsopts=defaults clk_ignore_unused pd_ignore_unused initcall_blacklist=efifb_driver_init;
	echo "Loaded direct boot payloads; entering booti";
	mw.l 46e07ffc 4a380004;
	booti 40080000 50000000:${direct_initrd_size} 4ff00000;
	mw.l 46e07ffc 4a380005;
	echo "booti returned"

fastbootcmd=echo "Fastboot Mode";
	fastboot -l $fastboot_addr_r usb 0

# A host `fastboot boot` is the explicit, one-shot UEFI-v2 retest trigger. Reset
# when EFI returns so the USB gadget is cleanly re-created by the next boot.
fastboot_bootcmd=run uefibootcmd;
	echo "UEFI path returned; resetting to diagnostic fastboot";
	reset
fastboot.iteration-mode=uefi-v2-retest-v21

bootmenu_0=Continue Boot=boot
bootmenu_1=Enter Fastboot Mode=run fastbootcmd
bootmenu_2=UEFI Maintenance Menu=eficonfig
bootmenu_3=Reboot=reset
bootmenu_4=Power Off=poweroff

button_cmd_0_name=Volume Down Key
button_cmd_0=bootmenu
