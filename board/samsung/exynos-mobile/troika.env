stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole

bootdelay=0
bootcmd=run fastbootcmd

fastbootcmd=echo "Entering U-Boot Fastboot Mode..."; fastboot -l $fastboot_addr_r usb 0

bootmenu_0=Enter Fastboot Mode=run fastbootcmd
bootmenu_1=Reboot=reset
bootmenu_2=Power Off=poweroff

button_cmd_0_name=Volume Down Key
button_cmd_0=run fastbootcmd
