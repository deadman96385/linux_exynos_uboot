stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole

blkmapcmd=blkmap create root;
	blkmap map root 0 ${blkmap_size_r} linear ${blkmap_blk_ifname} ${blkmap_blk_dev} ${blkmap_blk_nr}
pstorecmd=pstore set 46e00000 8000 0 4000 0 4000 0;
	pstore display user
preboot=run blkmapcmd; run pstorecmd
bootdelay=0
bootcmd=while run fastbootcmd; do echo "EFI returned; restarting fastboot"; done; reset
fastbootcmd=echo "XNU development fastboot"; fastboot -l $fastboot_addr_r usb 0

uefibootcmd=if load blkmap 0:1 ${loadaddr} /EFI/BOOT/BOOTAA64.EFI; then
	bootefi ${loadaddr};
	fi

/* Fastboot downloads do not register an EFI image: pass its explicit size.
 * Return to the outer USB loop so loader failures remain in OEM console. */
fastboot_bootcmd=if test ${filesize} = 4; then
	run uefibootcmd;
	else
	bootefi ${fastboot_addr_r}:${filesize};
	fi
fastboot.iteration-mode=exynos-xnu-loop-v1
bootmenu_0=Boot postmarketOS=run uefibootcmd
bootmenu_1=Enter Fastboot Mode=run fastbootcmd
bootmenu_2=Reboot=reset
bootmenu_3=Power Off=poweroff
button_cmd_0_name=Volume Down Key
button_cmd_0=bootmenu
