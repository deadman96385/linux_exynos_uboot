stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole

blkmapcmd=blkmap create root;
	  blkmap map root 0 ${blkmap_size_r} linear ${blkmap_blk_ifname} ${blkmap_blk_dev} ${blkmap_blk_nr}

preboot=run blkmapcmd

bootdelay=2
bootcmd=run uefibootcmd;
	echo "UEFI boot returned; entering fastboot recovery path";
	run fastbootcmd

uefibootcmd=echo "UEFI Boot from nested USERDATA";
	if load blkmap 0:1 ${loadaddr} /EFI/BOOT/BOOTAA64.EFI; then
		bootefi ${loadaddr};
	else
		echo "Failed to load BOOTAA64.EFI from nested USERDATA";
	fi

fastbootcmd=echo "Fastboot Mode";
	fastboot -l $fastboot_addr_r usb 0

# A host fastboot boot remains a one-shot way to retry UEFI. If EFI returns,
# reset so the installed production image recreates a clean USB gadget.
fastboot_bootcmd=run uefibootcmd; reset
fastboot.iteration-mode=j7y17lte-production-v22

bootmenu_0=Continue Boot=run uefibootcmd
bootmenu_1=Enter Fastboot Mode=run fastbootcmd
bootmenu_2=UEFI Maintenance Menu=eficonfig
bootmenu_3=Reboot=reset
bootmenu_4=Power Off=poweroff

button_cmd_0_name=Volume Down Key
button_cmd_0=bootmenu
